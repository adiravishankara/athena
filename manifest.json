{
    "manifest_version": 3,
    "name": "Athena",
    "version": "0.0.1.7",
    "description": "A tool for NotebookLM - working on badges, and adding youtube links",
    "action": {
        "default_popup": "build/index.html",
        "default_icon": {
            "16": "icons/athena16.ico",
            "32": "icons/athena32.ico",
            "48": "icons/athena48.ico",
            "128": "icons/athena128.ico"
        }
    },
    "permissions": [
        "storage",
        "activeTab",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "https://notebooklm.google.com/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "icons": {
        "16": "icons/athena16.ico",
        "32": "icons/athena32.ico",
        "48": "icons/athena48.ico",
        "128": "icons/athena128.ico"
    },
    "background": {
        "service_worker": "build/background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["build/contentScript.js"],
            "css": ["build/content.css"]
        }
    ]
}